{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qt;/usr/local/opt/qt"
      }
    },
    {
      "name": "dev",
      "displayName": "개발",
      "description": "개발용. 내장 모형(--sim)과 테스트를 포함한다. 납품 빌드에 쓰지 말 것.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HMI_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "납품",
      "description": "납품 구성. 내장 모형을 빼고 코어를 공유 라이브러리로 낸다 (과업지시서 4장의 라이브러리 모듈 요구).",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HMI_BUILD_TESTS": "ON",
        "HMI_SHARED_CORE": "ON",
        "HMI_WITH_TESTBED": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
