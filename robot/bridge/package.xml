<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>shalom_bridge</name>
  <version>0.1.0</version>
  <description>
    Bridge between the SHALOM control station and the ROS 2 stack on the robot.

    The control station does not run ROS 2. This node is the boundary: DDS ends
    here, and the link to the control PC is a single raw TCP connection. See
    docs/bridge_protocol.md for the wire protocol and the reasoning.
  </description>

  <maintainer email="hw.jo@wego-robotics.com">WEGO Robotics</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>nlohmann-json-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
