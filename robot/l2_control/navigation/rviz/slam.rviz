Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 40; 44; 52
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 40
      Color: 80; 80; 90
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.6
      Show Names: true
      Show Axes: true
      Show Arrows: false
    - Class: rviz_default_plugins/Map
      Name: SLAM Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.8
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR (raw)
      Enabled: false
      Topic:
        Value: /b2/points
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/PointCloud2
      Name: Ground points
      Enabled: true
      Topic:
        Value: /ground_segmentation/ground_points
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 90; 140; 90
    - Class: rviz_default_plugins/PointCloud2
      Name: Obstacle points
      Enabled: true
      Topic:
        Value: /ground_segmentation/obstacle_points
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 240; 120; 60
    - Class: rviz_default_plugins/LaserScan
      Name: Obstacle scan
      Enabled: true
      Topic:
        Value: /obstacle_scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 255; 255; 0
    - Class: rviz_default_plugins/Odometry
      Name: KISS-ICP odometry
      Enabled: true
      Topic:
        Value: /kiss/odometry
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Keep: 300
      Shape:
        Color: 100; 180; 255
        Shaft Length: 0.4
        Head Length: 0.15
        Alpha: 0.6
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 22
      Pitch: 1.02
      Yaw: 3.9
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 1000
  Width: 1600
  Displays:
    collapsed: false
