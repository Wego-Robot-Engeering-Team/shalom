<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>
    Production bring-up for the physical Unitree B2. It starts only the B2,
    commissioned sensors, LiDAR perception, odometry, localisation and Nav2.
    MuJoCo and test-only sensors belong to simulation_bringup and are never
    dependencies of this package.
  </description>
  <maintainer email="hw.jo@wego-robotics.com">juno</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>hmi_bridge</exec_depend>
  <exec_depend>b2_base</exec_depend>
  <exec_depend>safety_manager</exec_depend>
  <exec_depend>motion_interlock_manager</exec_depend>
  <exec_depend>teleop_bridge</exec_depend>
  <exec_depend>motion_mux</exec_depend>
  <exec_depend>safety_gate</exec_depend>

  <exec_depend>lidar_slam</exec_depend>
  <!-- Hesai Pandar XT32 adapter (lidar:=xt32). -->
  <exec_depend>pandar_xt32</exec_depend>
  <exec_depend>slamtec_aurora</exec_depend>
  <exec_depend>kiss_icp</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
