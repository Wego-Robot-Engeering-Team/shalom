<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup</name>
  <version>0.1.0</version>
  <description>
    Autonomy bring-up for the Unitree B2.  Assembles a robot (the MuJoCo stand-in
    or the physical machine), the lidar_slam perception chain, LiDAR
    odometry, SLAM and Nav2 into one launch.  The robot layer is a launch argument
    because both options expose the same interface, so nothing below this package
    knows which one is running.  Also carries the B2-specific tuning and saved maps.
  </description>
  <maintainer email="hw.jo@wego-robotics.com">juno</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>hmi_bridge</exec_depend>

  <exec_depend>lidar_slam</exec_depend>
  <exec_depend>realsense_d455</exec_depend>
  <exec_depend>video_streamer</exec_depend>
  <!-- 외장 라이다를 B2 자리에 끼울 때 쓴다 (lidar:=vlp16). -->
  <exec_depend>velodyne_vlp16</exec_depend>
  <exec_depend>aurora</exec_depend>
  <exec_depend>kiss_icp</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
