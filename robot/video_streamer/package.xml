<?xml version="1.0"?>
<package format="3">
  <name>video_streamer</name>
  <version>0.1.0</version>
  <description>
    카메라 컬러 영상을 H.264 로 눌러 RTSP 로 내보낸다.

    관제의 뷰파인더용이다. 실제 점검 사진은 정지 상태에서 원본으로 찍어
    NAS 로 보내므로(과업지시서 2.2.4), 이 경로는 화질이 아니라 지연이
    중요하다 — 조작자가 팔을 겨눌 때 화면이 밀리면 더 움직이게 된다.
  </description>
  <maintainer email="hw.jo@wego-robotics.com">Wego Robotics</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>

  <!-- GStreamer. 인코더 플러그인은 런타임에 고른다 (젯슨 NVENC / 개발 PC). -->
  <depend>libgstreamer1.0-dev</depend>
  <depend>libgstrtspserver-1.0-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
