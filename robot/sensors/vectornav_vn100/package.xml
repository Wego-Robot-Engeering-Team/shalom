<?xml version="1.0"?>
<package format="3">
  <name>vectornav_vn100</name>
  <version>0.1.0</version>
  <description>Robot-owned VN-100 IMU adapter and launch configuration.</description>
  <maintainer email="junoyoo@wego-robotics.com">Wego Robotics</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>vectornav_driver</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
