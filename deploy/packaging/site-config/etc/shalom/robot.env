# Shalom robot site configuration
#
# This file is a Debian conffile. Package upgrades do not overwrite local
# changes. Keep credentials and private keys in separately permissioned files;
# do not put them here.

ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Values below map directly to robot_bringup launch arguments. Uncomment and
# set them during commissioning. Empty values use the runtime's safe defaults.
# SHALOM_ROBOT_ID=R1
# SHALOM_ROBOT_NAME=1호기
# SHALOM_NETWORK_INTERFACE=enP8p1s0
# SHALOM_LIDAR=xt32
# SHALOM_AURORA=false
# SHALOM_AURORA_IP=192.168.11.1
# SHALOM_TELEOP_ALLOWED_PEER=192.168.0.10
# SHALOM_MAPS_DIR=/var/lib/shalom/maps
# SHALOM_MAP=/var/lib/shalom/maps/2026-09-07/map.yaml
