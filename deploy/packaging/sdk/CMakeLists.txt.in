cmake_minimum_required(VERSION 3.16)
project(robot_sdk_samples LANGUAGES CXX)

find_package(RobotSdk CONFIG REQUIRED)

add_executable(monitor monitor.cpp)
target_link_libraries(monitor PRIVATE robot_sdk::sdk)

add_executable(api_example api_example.cpp)
target_link_libraries(api_example PRIVATE robot_sdk::sdk)
