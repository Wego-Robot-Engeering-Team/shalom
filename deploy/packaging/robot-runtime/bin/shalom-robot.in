#!/usr/bin/env bash
set -euo pipefail

release_root="/opt/shalom/releases/@VERSION@"

if [[ ! -r /opt/ros/jazzy/setup.bash ]]; then
  echo "ROS 2 Jazzy runtime이 설치되지 않았습니다." >&2
  exit 1
fi

# Site configuration is intentionally external to the versioned runtime.
# robot.env may set ROS_DOMAIN_ID, RMW_IMPLEMENTATION and network-specific
# values, but credentials remain in separately permissioned files.
if [[ -r /etc/shalom/robot.env ]]; then
  set -a
  # shellcheck disable=SC1091
  source /etc/shalom/robot.env
  set +a
fi

# shellcheck disable=SC1091
source /opt/ros/jazzy/setup.bash
# shellcheck disable=SC1090
source "$release_root/setup.bash"

launch_args=()
append_launch_arg() {
  local env_name="$1"
  local launch_name="$2"
  if [[ -n "${!env_name:-}" ]]; then
    launch_args+=("${launch_name}:=${!env_name}")
  fi
}

# Keep the service contract small and explicit.  The site package owns these
# values; no customer-specific address or calibration is baked into the .deb.
append_launch_arg SHALOM_ROBOT_ID robot_id
append_launch_arg SHALOM_ROBOT_NAME robot_name
append_launch_arg SHALOM_NETWORK_INTERFACE network_interface
append_launch_arg SHALOM_LIDAR lidar
append_launch_arg SHALOM_AURORA aurora
append_launch_arg SHALOM_AURORA_IP aurora_ip
append_launch_arg SHALOM_TELEOP_ALLOWED_PEER teleop_allowed_peer
append_launch_arg SHALOM_MAPS_DIR maps_dir
append_launch_arg SHALOM_MAP map

exec ros2 launch robot_bringup bringup.launch.py "${launch_args[@]}" "$@"
