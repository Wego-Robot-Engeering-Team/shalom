[Unit]
Description=Shalom robot runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shalom
Group=shalom
StateDirectory=shalom
EnvironmentFile=-/etc/shalom/robot.env
ExecStart=/opt/shalom/releases/current/bin/robot-runtime
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
